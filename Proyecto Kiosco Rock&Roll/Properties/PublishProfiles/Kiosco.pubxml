<?xml version="1.0" encoding="utf-8"?>
<!--
  Publica el programa como un único KioscoRockAndRoll.exe que no necesita nada instalado
  (trae adentro .NET, SQLite y el motor de PDF).

  Desde Visual Studio: clic derecho en el proyecto > Publicar > perfil "Kiosco".
  Desde la terminal, en la carpeta de la solución:
      dotnet publish "Proyecto Kiosco Rock&Roll" -p:PublishProfile=Kiosco
  El resultado queda en la carpeta "publicar" de la solución.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Las librerías nativas (SQLite, PDF) van dentro del .exe y se extraen solas al abrirlo. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- También los archivos de contenido, como la fuente que usan los PDF: así queda un solo archivo. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Sin archivos de depuración (.pdb) de los otros proyectos de la solución. -->
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
    <!-- WinForms no admite recortar código no usado: se publica completo. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\publicar\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>
</Project>
